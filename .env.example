# Pick ONE backend: glm, ollama, qwen, openai, or groq.
# qwen uses QWEN_BASE_URL and QWEN_MODEL. After changing AMENDAQ_LLM, run scripts/restart-dev.sh.
AMENDAQ_LLM=glm

# --- Zhipu GLM (default when AMENDAQ_LLM=glm) ---
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash-250414
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# --- Ollama (AMENDAQ_LLM=ollama) ---
# Use your own host; do not check in LAN IPs.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=Qwen3.6

# --- OpenAI-compatible gateway (AMENDAQ_LLM=openai) ---
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_key_here

# --- Groq (AMENDAQ_LLM=groq) ---
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_BASE=https://api.groq.com/openai/v1

# Ingest: reject non-conforming FAQ/handbook (0 = warn only via ingest_notes)
AMENDAQ_INGEST_STRICT=1
# FAQ ingest: 1 = allow LLM compile for plain text/.md; 0 = markdown rules only
AMENDAQ_INGEST_FAQ_LLM=1

# Chat: 1 = API/UI returns full "answer+evidence"; 0 = answer only
AMENDAQ_CHAT_SHOW_EVIDENCE=0

# Wiki rigor audit: 1 = include LLM semantic check; 0 = deterministic rules only
AMENDAQ_WIKI_LLM_AUDIT=1

# Trace output directory (default: data/traces)
AMENDAQ_TRACE_DIR=data/traces

# TOC / FAQ batching settings
AMENDAQ_TOC_BATCH_SIZE=8
# After the single-pass cap, how many FAQ titles go in each batch.
# Qwen3.6 context is 262144; 200 titles are about 20k Chinese characters.
AMENDAQ_FAQ_BATCH_SIZE=200
# When published items are at or below this count, one call sees every title.
AMENDAQ_FAQ_SINGLE_PASS_MAX=200
# 1 = scan every batch (slower); 0 = allow the model to return done early (default)
AMENDAQ_FAQ_RECALL_ALL_BATCHES=0
AMENDAQ_FAQ_RECALL_MAX_PICKS=5
AMENDAQ_FAQ_RECALL_MAX_PICKS_ENUM=24
AMENDAQ_MAX_TOOL_ROUNDS=128

# Gradio legacy UI port
AMENDAQ_UI_PORT=7860

# Vite dev UI (scripts/restart-dev.sh)
AMENDAQ_WEB_PORT=5180
AMENDAQ_API_PORT=8765
# Listen address: 127.0.0.1 for local-only; 0.0.0.0 to share on your network
# AMENDAQ_BIND_HOST=127.0.0.1
