# 只改这一行：glm 或 ollama。改完执行 scripts/restart-dev.sh
MYCS_LLM=glm
GLM_API_KEY=
GLM_MODEL=glm-4-flash-250414

# 下面是两套已经配好的连接，不用改。MYCS_LLM=glm 用智谱，=ollama 用 110。
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
OLLAMA_BASE_URL=http://192.168.10.110:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Ingest: reject non-conforming FAQ/handbook (0 = warn only via ingest_notes)
MYCS_INGEST_STRICT=1
# FAQ 入库：1 = 纯文本/.md 可由大模型 compile（默认）；0 = 仅规范 Markdown 规则解析
MYCS_INGEST_FAQ_LLM=1

# Chat: 1 = API/界面返回完整「结论+依据」；0 = 仅结论（依据只写 joyjoy 日志）
MYCS_CHAT_SHOW_EVIDENCE=0

# Wiki 严谨性审核：1 = rigor audit 含 LLM 语义检查；0 = 仅确定性规则
MYCS_WIKI_LLM_AUDIT=1

# Trace output directory (default: data/traces)
MYCS_TRACE_DIR=data/traces

# 全面目录 / FAQ 分批：每批条数（仅当 published 条数 > MYCS_FAQ_SINGLE_PASS_MAX 时分批）
MYCS_TOC_BATCH_SIZE=8
# 扁平 FAQ 召回：已上线条数 ≤ 该值时一次 LLM 看完全部题干（星河 35 条 → 1 次召回）
MYCS_FAQ_SINGLE_PASS_MAX=120
# 1 = 召回强制扫完全部分批（慢）；0 = 允许 LLM done 提前结束（默认）
MYCS_FAQ_RECALL_ALL_BATCHES=0
# FAQ 召回：LLM 最多勾选 + 超出时本地重排截断（同一上限；未超出则保持 LLM 顺序）
MYCS_FAQ_RECALL_MAX_PICKS=5
MYCS_FAQ_RECALL_MAX_PICKS_ENUM=24
# 单问加载叶节点 by_section 上限（全面模式下可能很大）
MYCS_MAX_TOOL_ROUNDS=128

# Gradio port
MYCS_UI_PORT=7860

# Vite dev UI (scripts/restart-dev.sh)
MYCS_WEB_PORT=5180
# 监听地址：默认 0.0.0.0 供局域网同事访问；仅本机可设 127.0.0.1
# MYCS_BIND_HOST=0.0.0.0
MYCS_API_PORT=8765