# OpenAI-compatible gateway (default when MYCS_LLM=openai; no API key required)
# MYCS_LLM=openai
# OPENAI_API_BASE=http://192.168.10.175:8000/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=Qwen3.6

# Groq (default when MYCS_LLM=groq in ~/.zshrc)
# MYCS_LLM=groq
# GROQ_API_KEY=gsk_...
# GROQ_API_BASE=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MAX_TOKENS=2048
# GROQ_HTTP_RETRIES=6

# Ollama (MYCS_LLM=ollama)
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# Trace output directory (default: data/traces)
MYCS_TRACE_DIR=data/traces

# LLM backend: openai | ollama | glm | groq
MYCS_LLM=openai

# Gradio port
MYCS_UI_PORT=7860
