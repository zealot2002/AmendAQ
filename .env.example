# 智谱 GLM（默认）
MYCS_LLM=glm
GLM_API_KEY=
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash-250414

# OpenAI-compatible gateway（MYCS_LLM=openai，需 OPENAI_API_BASE）
# MYCS_LLM=openai
# OPENAI_API_BASE=http://localhost:8000/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Groq（MYCS_LLM=groq）
# MYCS_LLM=groq
# GROQ_API_KEY=gsk_...
# GROQ_API_BASE=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MAX_TOKENS=2048
# GROQ_HTTP_RETRIES=6

# Ollama（MYCS_LLM=ollama）
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# Ingest: reject non-conforming FAQ/handbook (0 = warn only via ingest_notes)
MYCS_INGEST_STRICT=1

# Chat: 1 = API/界面返回完整「结论+依据」；0 = 仅结论（依据只写 joyjoy 日志）
MYCS_CHAT_SHOW_EVIDENCE=0

# Wiki 严谨性审核：1 = rigor audit 含 LLM 语义检查；0 = 仅确定性规则
MYCS_WIKI_LLM_AUDIT=1

# Trace output directory (default: data/traces)
MYCS_TRACE_DIR=data/traces

# 全面目录：每批章/节数（越小 LLM 调用越多、越慢）
MYCS_TOC_BATCH_SIZE=8
# 单问加载叶节点 by_section 上限（全面模式下可能很大）
MYCS_MAX_TOOL_ROUNDS=128

# Gradio port
MYCS_UI_PORT=7860

# Vite dev UI (scripts/restart-dev.sh)
MYCS_WEB_PORT=5180